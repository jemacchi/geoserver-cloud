<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.geoserver.cloud</groupId>
    <artifactId>gs-cloud</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <groupId>org.geoserver.cloud.extensions</groupId>
  <artifactId>gs-cloud-extension-portolan</artifactId>
  <packaging>jar</packaging>
  <description>GeoServer Cloud auto-configuration for the Portolan WebUI extension</description>
  <dependencies>
    <dependency>
      <groupId>org.geoserver.cloud</groupId>
      <artifactId>gs-cloud-spring-factory</artifactId>
    </dependency>
    <dependency>
      <groupId>org.geoserver.community</groupId>
      <artifactId>gs-portolan</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.geoserver</groupId>
          <artifactId>gs-main</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.web</groupId>
          <artifactId>gs-web-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-cog-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-cog-http</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-cog-s3</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-cog-azure</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-cog-google</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-geoparquet</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.community</groupId>
          <artifactId>gs-pmtiles-store</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.geoserver.web</groupId>
      <artifactId>gs-web-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
